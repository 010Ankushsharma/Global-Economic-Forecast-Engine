# Database Configuration
DB_PASSWORD=your_secure_database_password
DATABASE_URL=postgresql://gefe_user:change_me@postgres:5432/gefe_db

# Redis Configuration
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://redis:6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Qdrant Vector DB
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=your_qdrant_api_key

# API Configuration
API_SECRET_KEY=your_super_secret_api_key
ENVIRONMENT=development
DEBUG=True

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Monitoring
GRAFANA_PASSWORD=admin123

# Data Sources API Keys
FRED_API_KEY=your_fred_api_key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key
NEWS_API_KEY=your_news_api_key
YAHOO_FINANCE_KEY=your_yahoo_finance_key

# Geopolitical Risk Data
GPR_INDEX_API_KEY=your_gpr_api_key

# AI Model Configuration
CUDA_VISIBLE_DEVICES=0
MODEL_CACHE_DIR=/models/cache
MAX_CONCURRENT_PREDICTIONS=100

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

# Security
JWT_SECRET_KEY=your_jwt_secret_key
JWT_EXPIRATION_HOURS=24

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
